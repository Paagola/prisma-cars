meta {
  name: Create car
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/cars
  body: json
  auth: inherit
}

body:json {
  {
    "model": "Ibiza",
    "color": "Rojo",
    "km": "12000",
    "userId": 1
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("carId", res.body.id);
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
